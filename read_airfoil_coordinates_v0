def get_curvilinear_coordinate(coords):
    # Calculate differences between consecutive points
    dx = np.diff(coords[:, 0])
    dy = np.diff(coords[:, 1])
    
    # Calculate segment lengths
    ds = np.sqrt(dx**2 + dy**2)
    
    # Cumulative sum starting from 0
    s = np.concatenate(([0], np.cumsum(ds)))
    
    # Normalize s from 0 to 1 (optional, but helpful for mapping)
    s_norm = s / s[-1]
    
    return s, s_norm

# Get the curvilinear s-coordinate
s, s_norm = get_curvilinear_coordinate(coords)
xi = np.linspace(0.,1.,len(s))
xi_new = np.linspace(0.,1.,2*len(s))

s_new = np.interp(xi_new,xi,s_norm)

bc_type = 'clamped' # Optional: enforces specific slopes at ends
spline_x = CubicSpline(s_norm, coords[:, 0])
spline_y = CubicSpline(s_norm, coords[:, 1])

# 2. Evaluate the splines at your new, refined curvilinear points
x_new = spline_x(s_new)
y_new = spline_y(s_new)

